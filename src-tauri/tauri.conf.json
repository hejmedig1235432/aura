{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aura",
  "version": "0.1.1",
  "identifier": "dk.iisa.aura",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Aura",
        "width": 1420,
        "height": 890,
        "minWidth": 300,
        "minHeight": 420,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "publisher": "Aura",
    "shortDescription": "A Spotify client",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "Aura"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNERTI4OUEyNEJFOTdDNTcKUldSWGZPbExvb25pUGVQWjJwSXE1cnVaL3hMcHlGWjlnYktjeWZaYkpndldHTy9BYVYyZnVFTngK",
      "endpoints": ["https://github.com/hejmedig1235432/aura/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
